# Copy this file to .env (it is git-ignored) and fill in the values. docker-compose.yml reads it.
# Never commit .env. In Azure these become app settings / Key Vault references with the same names
# after the "__" mapping shown in docker-compose.yml.

# --- SQL Server container ---------------------------------------------------
# At least 8 characters with upper, lower, digit and symbol, or SQL Server will not start.
SQL_SA_PASSWORD=

# --- Shared by Identity and Intake ------------------------------------------
# Identity checks it on /internal/accounts, Intake sends it. Must be identical for both,
# at least 32 characters, and must not start with "dev-only".
#   openssl rand -hex 32
INTERNAL_API_KEY=

# --- Identity ---------------------------------------------------------------
# RSA private key (2048+ bits) that signs the tokens. Keep it on one line in double quotes with \n for line breaks:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt | awk 'NF {printf "%s\\n", $0}'
JWT_PRIVATE_KEY_PEM=""
# Leave these empty for a new local stack. Admin signup is open, so the first admin can simply sign up through Intake.
# A bootstrap admin is only safe if Intake already holds an admin profile with the SAME id (BOOTSTRAP_ADMIN_ID);
# on an empty Intake database the first signup also gets id 1 and is refused as a duplicate.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ID=1

# --- Intake -----------------------------------------------------------------
# Salt for hashing tax IDs / SSNs. To keep working with an existing database it must match the old backend's
# TaxIdHashPepper. For a fresh local database any long random value works:  openssl rand -base64 32
TAX_ID_PEPPER=

# --- Both -------------------------------------------------------------------
# The Angular app's origin, for CORS.
CORS_ORIGIN=http://localhost:4200
