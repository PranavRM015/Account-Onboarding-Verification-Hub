server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Container Apps resolves app names through its own DNS; re-resolve instead of caching at startup.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    # Same routing as frontend/proxy.conf.json. Upstreams are full origins (scheme://host), set per environment.
    # Variables in proxy_pass keep the original request URI untouched.
    # Review: tickets
    location /api/admins/tickets {
        set $upstream ${REVIEW_UPSTREAM};
        proxy_pass $upstream;
        include /etc/nginx/proxy_params.conf;
    }

    # Intake: signup, input form, pending customers
    location ~ ^/api/(admins/(signup|inputForm|pending-customers)|users/signup) {
        set $upstream ${INTAKE_UPSTREAM};
        proxy_pass $upstream;
        include /etc/nginx/proxy_params.conf;
    }

    # Identity: everything else under /api
    location /api {
        set $upstream ${IDENTITY_UPSTREAM};
        proxy_pass $upstream;
        include /etc/nginx/proxy_params.conf;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Direct visits and reloads on /admin/login, /review/41, etc. load Angular.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
